# Environment & Secrets
.env
.env.*
!.env.example

# Virtual Environment
.venv/
venv/
ENV/
env/

# Python Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# Databases
*.db
*.sqlite
*.sqlite3

# Logs and local scratch work (screenshots, patches)
*.log
scratch/

# Local agent tooling settings (per-developer, never shared)
.claude/

# OS / IDE
.DS_Store
.idea/
.vscode/

# React build outputs and local dependencies
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Runtime user uploads
/uploads/

# Database dumps from backup_db.sh; deploy.sh runs git clean right after taking one
/backups/
# Scratch directory of scripts/offsite_restore_drill.sh, removed when it exits
/.offsite_drill.*/

# Local per-branch preview (scripts/preview.sh)
.preview.env

# Incremental build state of a local tsc run
frontend/*.tsbuildinfo

# Runtime logs (logs/smoke/*.json included); deploy.sh runs git clean
/logs/
