# Версия и сетевой режим. Deploy подставляет точный Git SHA вместо local.
APP_VERSION=local
API_HOST=0.0.0.0
API_PORT=8080
SERVE_STATIC=true
# false: /sw.js отдаёт выключатель, который удаляет service worker и его кэш (#499).
SERVICE_WORKER=true

# Legacy Telegram ID супер-админа для dev-входа; в production не нужен.
ADMIN_CHAT_ID=
DEFAULT_POLL_INTERVAL_MINUTES=15

# PostgreSQL: POSTGRES_PASSWORD используется Docker Compose, DATABASE_URL —
# прямым локальным запуском (в Docker Compose его подставляет compose).
# При смене пароля обновите оба значения.
POSTGRES_PASSWORD=replace-with-long-random-password
DATABASE_URL=postgresql+asyncpg://buyerly:replace-with-long-random-password@localhost:5432/buyerly

# Публичный URL, CORS и доверенные reverse-proxy сети. В Docker Compose прокси нет:
# compose задаёт TRUSTED_PROXY_CIDRS и CLOUDFLARE_TUNNEL_CIDRS сам.
WEBAPP_URL=https://buyerly.app
CORS_ORIGINS=https://buyerly.app
TRUSTED_PROXY_CIDRS=
# Сети Cloudflare: только от них API принимает CF-Connecting-IP и город посетителя.
# Пусто — опубликованный список https://www.cloudflare.com/ips/ (зашит в код); off — не верить заголовкам Cloudflare.
CLOUDFLARE_IP_CIDRS=
# Адреса Cloudflare Tunnel (cloudflared). В Docker Compose — его фиксированный адрес.
CLOUDFLARE_TUNNEL_CIDRS=

# Только для сервера (читает Docker Compose): включает контейнер Cloudflare Tunnel
# и передаёт ему токен туннеля из Cloudflare Zero Trust.
# COMPOSE_PROFILES=tunnel
# CLOUDFLARE_TUNNEL_TOKEN=

# Meta OAuth / Marketing API. Секрет и ключ шифрования храните только в .env сервера.
META_GRAPH_VERSION=v26.0
# Не менять на сервере: другой адрес нужен только локальному фейковому Meta (compose.dev.yaml).
META_GRAPH_BASE_URL=https://graph.facebook.com
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=
META_OAUTH_REDIRECT_URI=https://buyerly.app/api/meta/oauth/callback
# Для ротации: сначала новый ключ, затем старый через запятую.
META_TOKEN_ENCRYPTION_KEY=

# Web-сессии. В production cookie всегда передаётся только по HTTPS, а dev-auth
# должен оставаться выключенным. Для локального HTTP явно задайте secure=false.
WEB_SESSION_IDLE_DAYS=90
SESSION_COOKIE_SECURE=true
ENABLE_DEV_AUTH=false

# Только локальный стек (compose.dev.yaml): без RESEND_API_KEY письмо целиком,
# со ссылкой и кодом входа, пишется в лог API. В production всегда false.
DEV_EMAIL_LOG=false

# Вход и регистрация по коду из письма открыты для любой почты.
# Cloudflare Turnstile: секретный ключ виджета «Buyerly sign-up». На сервер его пишет деплой из секрета GitHub.
# Пусто — проверка выключена (локальная разработка).
TURNSTILE_SECRET_KEY=

# Telegram-бот Buyerly: только привязка аккаунта и уведомления. Токен от @BotFather
# храните только в .env сервера; webhook регистрируется сам при старте API.
TELEGRAM_BOT_TOKEN=

# Web Push для уведомлений Desktop (#503). На сервере ключ один раз создаёт деплой;
# менять его нельзя — подписки браузеров перестанут работать. Пусто — канала нет.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:team@buyerly.app

# Транзакционные письма отправляются только через Resend REST API.
RESEND_API_KEY=
EMAIL_FROM="Buyerly <team@buyerly.app>"

# Обязательный HMAC-секрет для хранения OTP-кодов.
OTP_PEPPER=

# Резервное копирование, потоковое шифрование и Off-site S3 (Cloudflare R2 / AWS S3).
# BACKUP_ENCRYPTION_KEY используется для шифрования дампов по AES-256-CBC с PBKDF2.
BACKUP_ENCRYPTION_KEY=
S3_ENDPOINT_URL=https://6be63d7c5503f2ee2b74c161e62e7c16.r2.cloudflarestorage.com
S3_BUCKET=buyerly-backups
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
OFFSITE_RETENTION_DAYS=60
