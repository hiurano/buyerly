    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@buyerly/shared": "*",
    "@fastify/cookie": "^11.1.5",
    "@fastify/multipart": "^10.1.4",
    "@fastify/static": "^10.1.7",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.35.5",
    "typeorm": "^1.1.2"
